# Copia este archivo a .env y pon tus valores. El .env NO se versiona.

# Cadena de conexión a la base de datos de Evolution API.
# Formato: postgresql://USUARIO:CLAVE@HOST:PUERTO/BASE?schema=ESQUEMA
EVOLUTION_DB_URL=postgresql://usuario:clave@localhost:5432/evolution_api?schema=public

# Nombre de la instancia de Evolution de la que se extrae (como la nombraste al crearla).
EVOLUTION_INSTANCIA=mi-instancia

# Carpeta donde se escriben los archivos extraídos. Déjala fuera del repositorio.
SALIDA=./salida
